---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Humikiri | Basecamp",
  description = "Humikiriのプロフィール、活動リンク、ブログ記事をまとめた個人サイトです。",
} = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b1112" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-[#0b1112] text-slate-100 antialiased">
    <div class="relative isolate min-h-screen overflow-hidden">
      <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-[34rem] bg-[radial-gradient(ellipse_at_top,rgba(45,212,191,0.12),transparent_65%)]"></div>
      <header class="mx-auto flex max-w-5xl items-center justify-between px-5 py-6 sm:px-8">
        <a class="font-semibold tracking-[0.18em] text-teal-100" href="/">HUMIKIRI</a>
        <nav aria-label="メインナビゲーション" class="flex items-center gap-5 text-sm text-slate-300">
          <a class="transition hover:text-teal-200" href="/#links">リンク</a>
          <a class="transition hover:text-teal-200" href="/blog/">ブログ</a>
        </nav>
      </header>
      <main class="mx-auto max-w-5xl px-5 pb-16 sm:px-8">
        <slot />
      </main>
      <footer class="mx-auto max-w-5xl border-t border-white/10 px-5 py-6 text-xs text-slate-500 sm:px-8">
        <p>&copy; {new Date().getFullYear()} QiPPU / humikiri</p>
      </footer>
    </div>
  </body>
</html>
