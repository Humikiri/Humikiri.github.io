---
import { getCollection } from "astro:content";
import SiteLayout from "../layouts/SiteLayout.astro";

const recentPosts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5);

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat("ja-JP", {
    year: "numeric",
    month: "long",
    day: "numeric",
    timeZone: "UTC",
  }).format(date);
---

<SiteLayout>
  <section class="grid gap-10 border-b border-white/10 py-14 sm:py-20 md:grid-cols-[1fr_auto] md:items-end">
    <div class="max-w-2xl">
      <p class="mb-5 text-xs font-semibold tracking-[0.28em] text-teal-300">ABOUT</p>
      <h1 class="text-4xl font-semibold tracking-tight text-white sm:text-6xl">Humikiri<span class="text-teal-300">.</span></h1>
      <p class="mt-6 max-w-xl text-base leading-8 text-slate-300 sm:text-lg">
        配信や創作活動、日々の記録を発信しています。
        各プラットフォームの活動や、このサイトのブログをご覧ください。
      </p>
    </div>
    <div class="rounded-2xl border border-white/10 bg-white/[0.03] px-5 py-4 md:min-w-52">
      <p class="text-xs tracking-[0.16em] text-slate-500">CREATOR</p>
      <p class="mt-2 font-medium text-slate-100">QiPPU / humikiri</p>
      <p class="mt-1 text-sm text-slate-400">配信・創作・ブログ</p>
    </div>
  </section>

  <section id="links" class="scroll-mt-8 py-12 sm:py-16">
    <div class="mb-6 flex items-end justify-between gap-4">
      <div>
        <p class="text-xs font-semibold tracking-[0.22em] text-teal-300">AROUND THE WEB</p>
        <h2 class="mt-2 text-2xl font-semibold text-white">活動リンク</h2>
      </div>
    </div>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <a
        class="group rounded-2xl border border-white/10 bg-white/[0.03] p-5 transition hover:-translate-y-0.5 hover:border-teal-300/40 hover:bg-white/[0.06]"
        href="https://github.com/Humikiri"
        target="_blank"
        rel="noopener noreferrer"
      >
        <div class="flex items-start justify-between">
          <span class="flex size-11 items-center justify-center rounded-xl border border-white/10 bg-white/5 text-slate-100">
            <svg aria-hidden="true" viewBox="0 0 24 24" class="size-6 fill-current">
              <path d="M12 .9a11.1 11.1 0 0 0-3.51 21.63c.56.1.76-.24.76-.54v-2.08c-3.1.68-3.76-1.31-3.76-1.31-.51-1.3-1.24-1.65-1.24-1.65-1.01-.69.08-.68.08-.68 1.12.08 1.71 1.15 1.71 1.15 1 1.7 2.62 1.21 3.26.93.1-.72.39-1.21.71-1.49-2.48-.28-5.09-1.24-5.09-5.52 0-1.22.44-2.21 1.15-2.99-.12-.28-.5-1.42.11-2.95 0 0 .94-.3 3.05 1.14a10.6 10.6 0 0 1 5.55 0c2.12-1.44 3.05-1.14 3.05-1.14.61 1.53.23 2.67.11 2.95.72.78 1.15 1.77 1.15 2.99 0 4.29-2.62 5.23-5.11 5.51.4.35.76 1.03.76 2.08v3.06c0 .3.2.65.77.54A11.1 11.1 0 0 0 12 .9Z" />
            </svg>
          </span>
          <span aria-hidden="true" class="pt-1 text-slate-500 transition group-hover:text-teal-200">↗</span>
        </div>
        <h3 class="mt-4 font-medium text-white">GitHub</h3>
        <p class="mt-2 text-sm leading-6 text-slate-400">制作物やプロジェクトを公開しています。</p>
      </a>
      <a
        class="group rounded-2xl border border-white/10 bg-white/[0.03] p-5 transition hover:-translate-y-0.5 hover:border-teal-300/40 hover:bg-white/[0.06]"
        href="https://twitch.tv/humikiri"
        target="_blank"
        rel="noopener noreferrer"
      >
        <div class="flex items-start justify-between">
          <span class="flex size-11 items-center justify-center rounded-xl border border-purple-300/20 bg-purple-400/10 text-purple-200">
            <svg aria-hidden="true" viewBox="0 0 24 24" class="size-6 fill-current">
              <path d="M4 2 1.8 6v14h5v2h3l2-2h4l5.4-5.4V2H4Zm15 11.6L16 16.5h-5l-2.5 2.4v-2.4H5V4h14v9.6ZM15.8 6.5h-2v5.2h2V6.5Zm-5.3 0h-2v5.2h2V6.5Z" />
            </svg>
          </span>
          <span aria-hidden="true" class="pt-1 text-slate-500 transition group-hover:text-teal-200">↗</span>
        </div>
        <h3 class="mt-4 font-medium text-white">Twitch</h3>
        <p class="mt-2 text-sm leading-6 text-slate-400">ライブ配信はこちらから。</p>
      </a>
      <a
        class="group rounded-2xl border border-white/10 bg-white/[0.03] p-5 transition hover:-translate-y-0.5 hover:border-teal-300/40 hover:bg-white/[0.06]"
        href="https://kakuyomu.jp/users/humikirich/works"
        target="_blank"
        rel="noopener noreferrer"
      >
        <div class="flex items-start justify-between">
          <span class="flex size-11 items-center justify-center rounded-xl border border-amber-300/20 bg-amber-400/10 font-serif text-lg font-bold text-amber-200">
            カ
          </span>
          <span aria-hidden="true" class="pt-1 text-slate-500 transition group-hover:text-teal-200">↗</span>
        </div>
        <h3 class="mt-4 font-medium text-white">カクヨム</h3>
        <p class="mt-2 text-sm leading-6 text-slate-400">最新の小説を公開しています。</p>
      </a>
      <a
        class="group rounded-2xl border border-white/10 bg-white/[0.03] p-5 transition hover:-translate-y-0.5 hover:border-teal-300/40 hover:bg-white/[0.06]"
        href="https://mypage.syosetu.com/806778/"
        target="_blank"
        rel="noopener noreferrer"
      >
        <div class="flex items-start justify-between">
          <span class="flex size-11 items-center justify-center rounded-xl border border-rose-300/20 bg-rose-400/10 font-serif text-lg font-bold text-rose-200">
            な
          </span>
          <span aria-hidden="true" class="pt-1 text-slate-500 transition group-hover:text-teal-200">↗</span>
        </div>
        <h3 class="mt-4 font-medium text-white">小説家になろう</h3>
        <p class="mt-2 text-sm leading-6 text-slate-400">過去に公開した小説はこちら。</p>
      </a>
      <a
        class="group rounded-2xl border border-white/10 bg-white/[0.03] p-5 transition hover:-translate-y-0.5 hover:border-teal-300/40 hover:bg-white/[0.06]"
        href="/pages/guideline.html"
      >
        <div class="flex items-start justify-between">
          <span class="flex size-11 items-center justify-center rounded-xl border border-teal-300/20 bg-teal-300/10 text-teal-200">
            <svg aria-hidden="true" viewBox="0 0 24 24" class="size-6 fill-none stroke-current" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 4.5h5.5A3.5 3.5 0 0 1 14 8v12a3.5 3.5 0 0 0-3.5-3.5H5z" />
              <path d="M19 4.5h-1.5A3.5 3.5 0 0 0 14 8v12a3.5 3.5 0 0 1 3.5-3.5H19z" />
            </svg>
          </span>
          <span aria-hidden="true" class="pt-1 text-slate-500 transition group-hover:text-teal-200">→</span>
        </div>
        <h3 class="mt-4 font-medium text-white">キズナ 二次創作ガイドライン</h3>
        <p class="mt-2 text-sm leading-6 text-slate-400">
          マスコットキャラクター「キズナ」の二次創作に関する案内です。
        </p>
      </a>
      <div aria-label="Zenn: リンク準備中" class="rounded-2xl border border-dashed border-white/15 bg-white/[0.015] p-5">
        <span aria-hidden="true" class="flex size-11 items-center justify-center rounded-xl border border-white/10 bg-white/[0.03] font-mono text-lg font-bold text-slate-400">Z</span>
        <h3 class="mt-4 font-medium text-slate-300">Zenn</h3>
        <p class="mt-2 text-sm leading-6 text-slate-500">リンク準備中</p>
      </div>
      <div aria-label="note: リンク準備中" class="rounded-2xl border border-dashed border-white/15 bg-white/[0.015] p-5">
        <span aria-hidden="true" class="flex size-11 items-center justify-center rounded-xl border border-white/10 bg-white/[0.03] text-slate-400">
          <svg viewBox="0 0 24 24" class="size-5 fill-none stroke-current" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 3.75h8l4 4v12.5H6z" />
            <path d="M14 3.75v4h4M9 12h6M9 15.5h6" />
          </svg>
        </span>
        <h3 class="mt-4 font-medium text-slate-300">note</h3>
        <p class="mt-2 text-sm leading-6 text-slate-500">リンク準備中</p>
      </div>
    </div>
    <p class="mt-5 text-sm text-slate-400">ご連絡はWickの <span class="text-slate-300">@humikiri</span> までお願いします。</p>
  </section>

  <section id="blog" class="scroll-mt-8 border-t border-white/10 py-12 sm:py-16">
    <div class="mb-6 flex items-end justify-between gap-4">
      <div>
        <p class="text-xs font-semibold tracking-[0.22em] text-teal-300">FROM THE JOURNAL</p>
        <h2 class="mt-2 text-2xl font-semibold text-white">ブログ新着記事</h2>
      </div>
      <a class="shrink-0 text-sm text-teal-300 transition hover:text-teal-100" href="/blog/">
        すべての記事を見る →
      </a>
    </div>
    {
      recentPosts.length > 0 ? (
        <ul class="divide-y divide-white/10">
          {recentPosts.map((post) => (
            <li>
              <a
                class="group grid gap-2 py-5 sm:grid-cols-[10rem_1fr] sm:gap-6"
                href={`/blog/${post.id}/`}
              >
                <time class="pt-1 text-sm text-slate-500" datetime={post.data.pubDate.toISOString()}>
                  {formatDate(post.data.pubDate)}
                </time>
                <div>
                  <h3 class="font-medium text-slate-100 transition group-hover:text-teal-200">{post.data.title}</h3>
                  {post.data.description && (
                    <p class="mt-2 text-sm leading-6 text-slate-400">{post.data.description}</p>
                  )}
                </div>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="rounded-2xl border border-dashed border-white/15 px-5 py-8 text-sm text-slate-400">
          ブログ記事は準備中です。公開した記事はこちらに表示されます。
        </p>
      )
    }
  </section>
</SiteLayout>
