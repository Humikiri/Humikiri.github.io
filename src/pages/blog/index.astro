---
import { getCollection } from "astro:content";
import SiteLayout from "../../layouts/SiteLayout.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat("ja-JP", {
    year: "numeric",
    month: "long",
    day: "numeric",
    timeZone: "UTC",
  }).format(date);
---

<SiteLayout title="ブログ記事一覧 | Humikiri">
  <section class="mx-auto max-w-3xl py-12 sm:py-16">
    <a class="text-sm text-teal-300 transition hover:text-teal-100" href="/">← トップページへ</a>
    <header class="mt-8 border-b border-white/10 pb-8">
      <p class="text-xs font-semibold tracking-[0.22em] text-teal-300">FROM THE JOURNAL</p>
      <h1 class="mt-3 text-3xl font-semibold tracking-tight text-white sm:text-5xl">ブログ記事一覧</h1>
      <p class="mt-4 text-slate-400">公開中の記事を新しい順に掲載しています。</p>
    </header>
    {
      posts.length > 0 ? (
        <ul class="divide-y divide-white/10">
          {posts.map((post) => (
            <li>
              <a class="group grid gap-2 py-5 sm:grid-cols-[10rem_1fr] sm:gap-6" href={`/blog/${post.id}/`}>
                <time class="pt-1 text-sm text-slate-500" datetime={post.data.pubDate.toISOString()}>
                  {formatDate(post.data.pubDate)}
                </time>
                <div>
                  <h2 class="font-medium text-slate-100 transition group-hover:text-teal-200">{post.data.title}</h2>
                  {post.data.description && (
                    <p class="mt-2 text-sm leading-6 text-slate-400">{post.data.description}</p>
                  )}
                  {post.data.tags.length > 0 && (
                    <ul class="mt-3 flex flex-wrap gap-2" aria-label="タグ">
                      {post.data.tags.map((tag) => (
                        <li class="rounded-full border border-white/10 px-2.5 py-1 text-xs text-slate-400">{tag}</li>
                      ))}
                    </ul>
                  )}
                </div>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="mt-8 rounded-2xl border border-dashed border-white/15 px-5 py-8 text-sm text-slate-400">
          まだ記事はありません。Markdownを <code class="text-teal-200">src/content/blog/</code> に追加すると、ここに表示されます。
        </p>
      )
    }
  </section>
</SiteLayout>
